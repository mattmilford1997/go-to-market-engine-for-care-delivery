# Arche GTM Engine — Environment Variables
# Copy to .env and fill in values as they become available.
# App starts without any API keys — modules degrade gracefully.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arche_gtm

# ── Supabase (optional — for hosted DB + storage) ─────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── AI / LLM ──────────────────────────────────────────────
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Module 1: Paid Ads ─────────────────────────────────────
# Per company — each company provides their own ad account keys
GOOGLE_ADS_DEVELOPER_TOKEN=
META_APP_ID=
META_APP_SECRET=

# ── Module 2: Referral Engine ──────────────────────────────
OPENFAX_API_KEY=
SLYBROADCAST_USERNAME=
SLYBROADCAST_PASSWORD=
LOB_API_KEY=
INSTANTLY_API_KEY=
ELEVENLABS_API_KEY=

# ── Module 4: SEO ──────────────────────────────────────────
# Free tier works without a key, but key increases rate limits
GOOGLE_PAGESPEED_API_KEY=

# ── Analytics (optional — operator-level, not per-company) ─
# Set ONE of these to enable traffic/event tracking for the SaaS app itself.
# GA4: get Measurement ID from Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# GTM: preferred if you want tag management flexibility
NEXT_PUBLIC_GTM_CONTAINER_ID=

# ── Debug ─────────────────────────────────────────────────
DEBUG=true
